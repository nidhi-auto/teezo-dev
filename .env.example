# Backend API base URL (e.g. http://localhost:3001). Leave empty when using the Vite /api proxy.
VITE_API_BASE_URL=http://localhost:3001

# Google OAuth client ID for the SPA (from Google Cloud Console).
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Must match an authorized redirect URI in Google Cloud and the SPA route /auth/callback.
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
